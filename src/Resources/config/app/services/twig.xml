<container xmlns="http://symfony.com/schema/dic/services">
    <services>
        <service class="Brille24\SyliusCustomerOptionsPlugin\Twig\CustomerOptionInUseFunction"
                 id="brille24.sylius_customer_options_plugin.twig.customer_option_in_use_function">
            <argument type="service" id="brille24.repository.order_item_option" />

            <tag name="twig.extension" />
        </service>
        <service
                id="sylius_admin.twig.component.customer_option.form"
                class="Brille24\SyliusCustomerOptionsPlugin\Twig\Component\CustomerOption\FormComponent"
        >
            <argument type="service" id="brille24.repository.customer_option" />
            <argument type="service" id="form.factory" />
            <argument>Brille24\SyliusCustomerOptionsPlugin\Entity\CustomerOption</argument>
            <argument>Brille24\SyliusCustomerOptionsPlugin\Form\CustomerOptionType</argument>

            <tag name="sylius.live_component.admin" key="brille24:customer_option:form" />
            <tag name="twig.component" key="brille24:customer_option:form" />
        </service>
    </services>
</container>
