{% set path = options.link.url|default(path(options.link.route)) %}

<a href="{{ path }}"
   class="ui yellow labeled icon button"
   id="sylius_admin_customer_option_refresh_elasticsearch">
    {% if options.icon is defined %}
        <i class="{{ options.icon }} icon"></i>
    {% endif %}
    {{ action.label|trans }}
</a>
