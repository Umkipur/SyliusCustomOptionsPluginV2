{# src/Resources/views/CustomerOption/_form.html.twig #}

{% extends '@SyliusAdminUi/Crud/_form.html.twig' %}

{% form_theme form '@SyliusAdmin/Form/bootstrap_5_layout.html.twig' %}

{% block sylius_admin_crud_form %}
    <div class="card mb-4">
        <div class="card-header">
            {{ 'sylius.ui.details'|trans }}
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4">{{ form_row(form.code) }}</div>
                <div class="col-md-4">{{ form_row(form.type, {'attr': {'onchange': 'this.form.submit();'}}) }}</div>
                <div class="col-md-4">{{ form_row(form.required) }}</div>
            </div>
            {{ form_row(form.translations) }}
        </div>
    </div>

    {% set customerOptionType = form.type.vars.value %}
    <div class="card mb-4">
        <div class="card-header">
            {{ 'brille24.ui.configuration'|trans }}
        </div>
        <div class="card-body">
            {% if customerOptionType in ['select', 'multi_select'] %}
                {% include '@Brille24SyliusCustomerOptionsPlugin/CustomerOption/_values.html.twig' with {'form': form.values} %}
            {% else %}
                {{ form_row(form.configuration) }}
            {% endif %}
        </div>
    </div>
{% endblock %}
