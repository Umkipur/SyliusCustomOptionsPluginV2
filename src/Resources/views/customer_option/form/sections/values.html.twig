<div class="card mb-3">
    <div class="card-header">
        <div class="card-title">{{ 'sylius.ui.values'|trans }}</div>
    </div>
    <div class="card-body">
        <div class="row" {{ sylius_test_html_attribute('option-values') }}>
            {{ form_errors(form.values) }}

            {% for value_form in form.values %}
                {% hook 'sylius_admin.customer_option.update.content.form.sections.values' with { form: value_form } %}
            {% endfor %}
        </div>

        <div class="mt-3">
            <button type="button" class="ui labeled icon button" data-form-collection-add
                    data-form-collection="values"
                    {{ sylius_test_html_attribute('add-option-value') }}>
                <i class="icon plus"></i>
                {{ 'sylius.form.option_value.add_value'|trans }}
            </button>
        </div>
    </div>
</div>
